{
  "manifest_version": 1,
  "type": "device",
  "name": "Cumulus & Weather Display",
  "description": {
    "en": "Your weather station in Gladys through Cumulus MX or Weather Display, whatever its brand.",
    "fr": "Votre station météo dans Gladys via Cumulus MX ou Weather Display, quelle que soit sa marque.",
    "de": "Deine Wetterstation in Gladys über Cumulus MX oder Weather Display, egal welche Marke.",
    "es": "Su estación meteorológica en Gladys con Cumulus MX o Weather Display, sea cual sea su marca."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-cumulus:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-cumulus/main/cover.png",
  "categories": ["environment"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect the station",
        "fr": "Connecter la station",
        "de": "Station verbinden",
        "es": "Conectar la estación"
      },
      "description": {
        "en": "Choose what to read. Cumulus MX: its interface on port 8998, live. realtime.txt: the file Cumulus 1 or MX writes. clientraw.txt: the file of Weather Display. A file is read at the address of the web server that serves it.",
        "fr": "Choisissez ce qui est lu. Cumulus MX : son interface sur le port 8998, en direct. realtime.txt : le fichier écrit par Cumulus 1 ou MX. clientraw.txt : le fichier de Weather Display. Un fichier se lit à l'adresse du serveur web qui le sert.",
        "de": "Wähle, was gelesen wird. Cumulus MX: seine Oberfläche auf Port 8998, live. realtime.txt: die Datei, die Cumulus 1 oder MX schreibt. clientraw.txt: die Datei von Weather Display. Eine Datei wird unter der Adresse des Webservers gelesen, der sie ausliefert.",
        "es": "Elija qué se lee. Cumulus MX: su interfaz en el puerto 8998, en directo. realtime.txt: el archivo que escribe Cumulus 1 o MX. clientraw.txt: el archivo de Weather Display. Un archivo se lee en la dirección del servidor web que lo sirve."
      },
      "links": [
        {
          "url": "https://www.cumuluswiki.org/a/Main_Page",
          "label": {
            "en": "Cumulus wiki",
            "fr": "Wiki de Cumulus",
            "de": "Cumulus-Wiki",
            "es": "Wiki de Cumulus"
          }
        }
      ]
    },
    {
      "key": "source",
      "type": "select",
      "default": "cumulusmx",
      "label": {
        "en": "Source",
        "fr": "Source",
        "de": "Quelle",
        "es": "Fuente"
      },
      "options": [
        {
          "value": "cumulusmx",
          "label": {
            "en": "Cumulus MX (API)",
            "fr": "Cumulus MX (API)",
            "de": "Cumulus MX (API)",
            "es": "Cumulus MX (API)"
          }
        },
        {
          "value": "realtime",
          "label": {
            "en": "realtime.txt file (Cumulus)",
            "fr": "Fichier realtime.txt (Cumulus)",
            "de": "Datei realtime.txt (Cumulus)",
            "es": "Archivo realtime.txt (Cumulus)"
          }
        },
        {
          "value": "clientraw",
          "label": {
            "en": "clientraw.txt file (Weather Display)",
            "fr": "Fichier clientraw.txt (Weather Display)",
            "de": "Datei clientraw.txt (Weather Display)",
            "es": "Archivo clientraw.txt (Weather Display)"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Address",
        "fr": "Adresse",
        "de": "Adresse",
        "es": "Dirección"
      },
      "description": {
        "en": "Cumulus MX: the address of its interface. A file: its full address.",
        "fr": "Cumulus MX : l'adresse de son interface. Un fichier : son adresse complète.",
        "de": "Cumulus MX: die Adresse seiner Oberfläche. Eine Datei: ihre vollständige Adresse.",
        "es": "Cumulus MX: la dirección de su interfaz. Un archivo: su dirección completa."
      },
      "placeholder": {
        "en": "e.g. http://192.0.2.10:8998",
        "fr": "ex. http://192.0.2.10:8998",
        "de": "z. B. http://192.0.2.10:8998",
        "es": "p. ej. http://192.0.2.10:8998"
      }
    },
    {
      "key": "interval",
      "type": "number",
      "default": 30,
      "min": 10,
      "max": 3600,
      "label": {
        "en": "Reading interval (s)",
        "fr": "Intervalle de lecture (s)",
        "de": "Leseintervall (s)",
        "es": "Intervalo de lectura (s)"
      },
      "description": {
        "en": "Cumulus MX reads the station every few seconds; the files are rewritten at their realtime interval.",
        "fr": "Cumulus MX lit la station toutes les quelques secondes ; les fichiers sont réécrits à leur intervalle temps réel.",
        "de": "Cumulus MX liest die Station alle paar Sekunden; die Dateien werden in ihrem Echtzeit-Intervall neu geschrieben.",
        "es": "Cumulus MX lee la estación cada pocos segundos; los archivos se reescriben en su intervalo de tiempo real."
      }
    },
    {
      "key": "language",
      "type": "select",
      "default": "fr",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Feature names of the station when it is added, scene sentences and action messages.",
        "fr": "Noms des fonctionnalités de la station à son ajout, phrases des scènes et messages des actions.",
        "de": "Namen der Funktionen der Station beim Hinzufügen, Szenen-Sätze und Meldungen der Aktionen.",
        "es": "Nombres de las funciones de la estación al añadirla, frases de escenas y mensajes de las acciones."
      },
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "check_source",
      "timeout_seconds": 20,
      "label": {
        "en": "Check the source",
        "fr": "Vérifier la source",
        "de": "Quelle prüfen",
        "es": "Comprobar la fuente"
      },
      "description": {
        "en": "Reads the source now and tells what it gives.",
        "fr": "Lit la source maintenant et indique ce qu'elle donne.",
        "de": "Liest die Quelle jetzt und zeigt, was sie liefert.",
        "es": "Lee la fuente ahora e indica lo que ofrece."
      }
    }
  ],
  "scene_triggers": [
    {
      "key": "rain_started",
      "label": {
        "en": "Cumulus: it starts raining",
        "fr": "Cumulus : il commence à pleuvoir",
        "de": "Cumulus: Es beginnt zu regnen",
        "es": "Cumulus: empieza a llover"
      },
      "description": {
        "en": "The station measures rain after at least 30 minutes without any. Fires once per rain episode.",
        "fr": "La station mesure de la pluie après au moins 30 minutes sans. Se déclenche une fois par épisode de pluie.",
        "de": "Die Station misst Regen nach mindestens 30 Minuten ohne. Löst einmal pro Regenepisode aus.",
        "es": "La estación mide lluvia tras al menos 30 minutos sin ella. Se activa una vez por episodio de lluvia."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Station",
            "es": "Estación"
          }
        }
      ],
      "variables": [
        {
          "key": "station",
          "type": "string",
          "label": {
            "en": "Station name",
            "fr": "Nom de la station",
            "de": "Name der Station",
            "es": "Nombre de la estación"
          }
        }
      ]
    },
    {
      "key": "rain_stopped",
      "label": {
        "en": "Cumulus: the rain stops",
        "fr": "Cumulus : la pluie s'arrête",
        "de": "Cumulus: Der Regen hört auf",
        "es": "Cumulus: deja de llover"
      },
      "description": {
        "en": "No rain for the chosen time after rain. Fires once per dry spell.",
        "fr": "Plus de pluie depuis la durée choisie, après de la pluie. Se déclenche une fois par accalmie.",
        "de": "Kein Regen mehr seit der gewählten Dauer, nach Regen. Löst einmal pro Trockenphase aus.",
        "es": "Sin lluvia durante el tiempo elegido, tras haber llovido. Se activa una vez por periodo seco."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Station",
            "es": "Estación"
          }
        },
        {
          "key": "after_minutes",
          "type": "select",
          "required": true,
          "default": "30",
          "label": {
            "en": "Dry for",
            "fr": "Sans pluie depuis",
            "de": "Trocken seit",
            "es": "Sin lluvia desde hace"
          },
          "options": [
            {
              "value": "15",
              "label": {
                "en": "15 minutes",
                "fr": "15 minutes",
                "de": "15 Minuten",
                "es": "15 minutos"
              }
            },
            {
              "value": "30",
              "label": {
                "en": "30 minutes",
                "fr": "30 minutes",
                "de": "30 Minuten",
                "es": "30 minutos"
              }
            },
            {
              "value": "60",
              "label": {
                "en": "60 minutes",
                "fr": "60 minutes",
                "de": "60 Minuten",
                "es": "60 minutos"
